{
  "name": "gbfm",
  "version": "2.50.1",
  "sideEffects": false,
  "private": true,
  "scripts": {
    "dev": "sst dev --stage=dev --verbose",
    "refresh": "sst refresh --stage=dev",
    "deploy": "sst deploy --stage=dev",
    "deploy:prod": "sst deploy --stage=prod",
    "gen": "cd vps && sst shell drizzle-kit generate",
    "release": "semantic-release",
    "typecheck": "tsgo --noEmit && bun --filter='*' typecheck",
    "test": "cd packages/core && bun run test && cd ../theme && bun run test && cd ../../apps/vps && bun run test && cd ../raycast && bun run test",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "biome:ci": "biome ci",
    "precommit": "bun run format && bun run check && bun run typecheck",
    "ci": "bun run biome:ci && bun run typecheck && bun run test && cd apps/www && bun run build",
    "prepare": "effect-language-service patch",
    "init:lefthook": "lefthook install"
  },
  "dependencies": {
    "@effect/cli": "0.75.1",
    "@effect/platform": "0.96.1",
    "effect": "4.0.0-beta.70",
    "gray-matter": "4.0.3",
    "sst": "4.14.3",
    "vitest": "4.1.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@effect/language-service": "0.85.1",
    "@pulumi/hcloud": "^1.34.0",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.8",
    "@tsconfig/bun": "1.0.10",
    "@typescript/native-preview": "7.0.0-dev.20260508.1",
    "lefthook": "2.1.6",
    "madge": "8.0.0",
    "semantic-release": "25.0.3",
    "typescript": "6.0.3"
  },
  "overrides": {
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "effect": "4.0.0-beta.70"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "trustedDependencies": [
    "@biomejs/biome",
    "aws-sdk",
    "esbuild",
    "ffmpeg-static",
    "sharp"
  ]
}
