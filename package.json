{
  "name": "gbfm",
  "version": "0.28.1",
  "sideEffects": false,
  "private": true,
  "scripts": {
    "dev": "sst dev --stage=dev",
    "refresh": "sst refresh --stage=dev",
    "sso": "aws sso login --sso-session=terminal --no-browser",
    "typecheck": "bun --filter=* typecheck",
    "deploy": "sst deploy --stage=dev",
    "deploy:prod": "sst deploy --stage=prod",
    "gen": "cd vps && sst shell drizzle-kit generate",
    "release": "semantic-release",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "biome:ci": "biome ci"
  },
  "dependencies": {
    "@mdx-js/mdx": "3.1.1",
    "effect": "3.18.2",
    "gray-matter": "4.0.3",
    "sst": "3.17.14",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.5",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@tsconfig/bun": "^1.0.8",
    "lefthook": "^1.13.6",
    "semantic-release": "^24.2.9",
    "typescript": "5.8.3"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "trustedDependencies": [
    "@biomejs/biome",
    "aws-sdk",
    "esbuild",
    "ffmpeg-static",
    "sharp"
  ]
}
