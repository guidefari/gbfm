{
	"name": "gbfm",
	"version": "0.4.7",
	"sideEffects": false,
	"scripts": {
		"dev": "sst dev --stage=dev",
		"refresh": "sst refresh --stage=dev",
		"sso": "aws sso login --sso-session=terminal --no-browser",
		"typecheck": "bun --filter=* typecheck",
		"deploy": "sst deploy --stage=dev",
		"deploy:prod": "sst deploy --stage=prod",
		"gen": "cd vps && sst shell drizzle-kit generate"
	},
	"workspaces": [
		"backend",
		"core",
		"web",
		"vps"
	],
	"dependencies": {
		"@effect/platform": "0.86.0",
		"@effect/schema": "0.75.5",
		"@mdx-js/mdx": "3.1.0",
		"effect": "3.16.9",
		"gray-matter": "4.0.3",
		"sst": "3.17.10",
		"zod": "3.25.67"
	},
	"devDependencies": {
		"@tsconfig/node20": "20.1.6",
		"typescript": "5.8.3"
	},
	"overrides": {
		"react": "19.1.0",
		"react-dom": "19.1.0"
	}
}
