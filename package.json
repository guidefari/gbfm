{
  "name": "gbfm",
  "version": "1.8.2",
  "sideEffects": false,
  "private": true,
  "scripts": {
    "dev": "sst dev --stage=dev",
    "refresh": "sst refresh --stage=dev",
    "sso": "aws sso login --sso-session=terminal --no-browser",
    "typecheck": "bun --filter=* typecheck",
    "deploy": "sst deploy --stage=dev",
    "deploy:prod": "sst deploy --stage=prod",
    "gen": "cd vps && sst shell drizzle-kit generate",
    "release": "semantic-release",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "biome:ci": "biome ci",
    "prepare": "effect-language-service patch"
  },
  "dependencies": {
    "@effect/cli": "0.72.1",
    "@effect/platform": "0.93.6",
    "effect": "3.19.8",
    "gray-matter": "4.0.3",
    "sst": "3.17.23",
    "vitest": "3.2.4",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@effect/language-service": "^0.60.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@tsconfig/bun": "1.0.10",
    "lefthook": "^1.13.6",
    "semantic-release": "^24.2.9",
    "typescript": "5.8.3"
  },
  "overrides": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "trustedDependencies": [
    "@biomejs/biome",
    "aws-sdk",
    "esbuild",
    "ffmpeg-static",
    "sharp"
  ]
}
