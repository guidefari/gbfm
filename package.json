{
  "name": "gbfm",
  "version": "2.86.0",
  "sideEffects": false,
  "private": true,
  "scripts": {
    "dev": "bunx alchemy dev --stage=dev",
    "dev:d1": "bun --filter @gbfm/www dev:d1",
    "deploy": "bunx alchemy deploy --stage=dev",
    "deploy:prod": "bunx alchemy deploy --stage=prod --profile env-token --yes",
    "gen": "cd apps/server && npx drizzle-kit generate --config drizzle.config.prod.ts",
    "studio:prod": "cd apps/server && bun scripts/drizzle-studio.ts --target=prod",
    "db:migrate:prod": "cd apps/server && bun run src/migrate.ts",
    "email:preview": "bun --filter @gbfm/email dev",
    "ui:playground": "bun --filter @gbfm/ui dev",
    "otel": "docker compose up jaeger -d",
    "release": "semantic-release",
    "typecheck": "tsgo --noEmit && bun --filter='*' typecheck",
    "test": "cd packages/core && bun run test && cd ../theme && bun run test && cd ../player && bun run test && cd ../../apps/mobile && bun run test && cd ../server && bun run test && cd ../../workers/cdn-router && bun run test",
    "lint": "bun ./node_modules/oxlint/dist/cli.js apps/*/src packages workers '*.{js,ts,tsx,jsx}' --no-error-on-unmatched-pattern",
    "lint:fix": "bun ./node_modules/oxlint/dist/cli.js apps/*/src packages workers '*.{js,ts,tsx,jsx}' --fix --no-error-on-unmatched-pattern",
    "format": "node ./node_modules/oxfmt/dist/cli.js apps/*/src packages workers '*.{js,ts,tsx,jsx,json,css}' --write --no-error-on-unmatched-pattern",
    "format:check": "node ./node_modules/oxfmt/dist/cli.js apps/*/src packages workers '*.{js,ts,tsx,jsx,json,css}' --check --no-error-on-unmatched-pattern",
    "check": "bun run format && bun run lint:fix",
    "oxc:ci": "bun run format:check && bun run lint",
    "precommit": "bun run check && bun run typecheck",
    "ci": "bun run oxc:ci && bun run typecheck && bun run test && cd apps/www && bun run build",
    "prepare": "effect-language-service patch",
    "init:lefthook": "lefthook install"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1038.0",
    "@aws-sdk/s3-request-presigner": "3.1038.0",
    "@effect/cli": "0.75.2",
    "@effect/platform": "0.96.2",
    "@effect/platform-bun": "4.0.0-beta.99",
    "@effect/platform-node": "4.0.0-beta.99",
    "alchemy": "2.0.0-beta.64",
    "effect": "4.0.0-beta.99",
    "gray-matter": "4.0.3",
    "vitest": "4.1.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@effect/language-service": "0.86.4",
    "@oxlint/plugins": "1.78.0",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.8",
    "@tsconfig/bun": "1.0.10",
    "@types/bun": "1.3.13",
    "@typescript/native-preview": "7.0.0-dev.20260612.1",
    "lefthook": "2.1.9",
    "madge": "8.0.0",
    "oxfmt": "0.54.0",
    "oxlint": "1.78.0",
    "semantic-release": "25.0.5",
    "typescript": "6.0.3"
  },
  "overrides": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "lightningcss": "1.30.1"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "workers/*"
  ],
  "trustedDependencies": [
    "aws-sdk",
    "esbuild",
    "sharp"
  ]
}
