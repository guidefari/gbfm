{
  "name": "gbfm",
  "version": "2.10.0",
  "sideEffects": false,
  "private": true,
  "scripts": {
    "dev": "sst dev --stage=dev",
    "refresh": "sst refresh --stage=dev",
    "sso": "aws sso login --sso-session=terminal --no-browser",
    "deploy": "sst deploy --stage=dev",
    "deploy:prod": "sst deploy --stage=prod",
    "gen": "cd vps && sst shell drizzle-kit generate",
    "release": "semantic-release",
    "typecheck": "bun --filter=* typecheck",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "biome:ci": "biome ci",
    "precommit": "bun run format && bun run check && bun run typecheck",
    "ci": "bun run biome:ci && bun run typecheck && cd apps/www && bun run build",
    "prepare": "effect-language-service patch && lefthook install"
  },
  "dependencies": {
    "@effect/cli": "0.73.0",
    "@effect/platform": "0.94.2",
    "effect": "3.19.15",
    "gray-matter": "4.0.3",
    "sst": "3.17.25",
    "vitest": "4.0.17",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@effect/language-service": "^0.72.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.2",
    "@tsconfig/bun": "1.0.10",
    "lefthook": "^2.0.15",
    "madge": "^8.0.0",
    "semantic-release": "^25.0.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "effect": "3.19.15"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "trustedDependencies": [
    "@biomejs/biome",
    "aws-sdk",
    "esbuild",
    "ffmpeg-static",
    "sharp"
  ]
}
