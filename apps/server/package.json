{
  "name": "@gbfm/server",
  "exports": {
    "./schemas": "./src/db/exports.ts"
  },
  "scripts": {
    "test": "vitest run --config vitest.unit.config.ts && vitest run --config vitest.d1.config.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:d1": "vitest run --config vitest.d1.config.ts",
    "test:watch": "vitest --config vitest.d1.config.ts",
    "typecheck": "tsgo --noEmit",
    "db:gen": "drizzle-kit generate --config drizzle.d1.config.ts",
    "db:seed:music-lookups": "bun run scripts/seed-music-lookups.ts",
    "identity:maintain": "bun run scripts/music-identity-maintenance.ts"
  },
  "dependencies": {
    "@effect/cli": "0.77.2",
    "@effect/experimental": "0.61.1",
    "@effect/opentelemetry": "4.0.0-rc.117",
    "@effect/platform": "0.97.2",
    "@effect/platform-bun": "4.0.0-rc.117",
    "@gbfm/api": "workspace:*",
    "@gbfm/core": "workspace:*",
    "@gbfm/email": "workspace:*",
    "@gbfm/pdf-generator": "workspace:*",
    "@gbfm/social-card": "workspace:*",
    "@gbfm/site-metadata": "workspace:*",
    "@mdx-js/mdx": "3.1.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "@opentelemetry/sdk-trace-web": "2.11.0",
    "@sentry/bun": "10.75.3",
    "@sentry/cloudflare": "10.75.3",
    "@sentry/core": "10.75.3",
    "@sentry/opentelemetry": "10.75.3",
    "@spotify-effect/core": "0.6.7",
    "better-auth": "1.7.5",
    "dotenv": "18.0.3",
    "dotenv-expand": "1000.0.0",
    "drizzle-orm": "0.45.3",
    "effect": "4.0.0-rc.117",
    "gray-matter": "4.0.3",
    "openapi-fetch": "^0.17.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "resend": "6.28.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260923.1",
    "@types/aws-lambda": "8.10.163",
    "@types/bun": "1.4.2",
    "drizzle-kit": "0.31.11",
    "miniflare": "5.20260801.1-alpha",
    "openapi-typescript": "^7.13.0",
    "typescript": "7.0.2"
  }
