    "@sentry/core": "10.52.0",
    "@sentry/opentelemetry": "^10.52.0",
    "@spotify-effect/core": "0.6.6",
    "@types/qrcode": "1.5.6",
    "better-auth": "1.6.22",
    "dotenv": "17.4.2",
