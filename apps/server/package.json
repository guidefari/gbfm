{
  "name": "@gbfm/server",
  "exports": {
    "./schemas": "./src/db/exports.ts"
  },
  "scripts": {
    "test": "vitest run --config vitest.unit.config.ts && vitest run --config vitest.d1.config.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:d1": "vitest run --config vitest.d1.config.ts",
    "test:watch": "vitest --config vitest.d1.config.ts",
    "typecheck": "tsgo --noEmit",
    "db:gen": "drizzle-kit generate --config drizzle.d1.config.ts",
    "db:seed:music-lookups": "bun run scripts/seed-music-lookups.ts"
  },
