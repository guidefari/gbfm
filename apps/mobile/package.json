{
  "name": "@gbfm/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run src",
    "device:build": "eas build --profile development --platform ios",
    "device:install": "eas build:run --platform ios --latest",
    "device": "bun run device:build && bun run device:install",
    "device:local": "expo run:ios --device"
  },
  "dependencies": {
    "@effect/atom-react": "4.0.6",
    "@gbfm/api": "workspace:*",
    "@gbfm/core": "workspace:*",
    "@gbfm/player": "workspace:*",
    "@gbfm/spotify": "workspace:*",
    "@gbfm/theme": "workspace:*",
    "@spotify-effect/browser": "0.6.7",
    "@spotify-effect/core": "0.6.7",
    "babel-preset-expo": "~58.0.0",
    "effect": "4.0.6",
    "expo": "^58.0.21",
    "expo-asset": "~58.0.19",
    "expo-audio": "~58.0.10",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.17",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "nativewind": "5.0.0-rc.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-css": "3.1.0-rc.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "postcss": "8.5.31",
    "typescript": "~6.0.3",
    "vitest": "5.0.5"
  }
}
