{
  "name": "@gbfm/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsgo --noEmit",
    "device:build": "eas build --profile development --platform ios",
    "device:install": "eas build:run --platform ios --latest",
    "device": "bun run device:build && bun run device:install",
    "device:local": "expo run:ios --device"
  },
  "dependencies": {
    "@effect/atom-react": "4.0.0-beta.99",
    "@expo/metro-config": "~57.0.6",
    "@gbfm/api": "workspace:*",
    "@gbfm/core": "workspace:*",
    "@gbfm/theme": "workspace:*",
    "babel-preset-expo": "~57.0.0",
    "effect": "4.0.0-beta.99",
    "expo": "^57.0.7",
    "expo-audio": "~57.0.2",
    "expo-constants": "~57.0.6",
    "expo-dev-client": "^57.0.7",
    "expo-font": "^57.0.1",
    "expo-linear-gradient": "^57.0.1",
    "expo-linking": "~57.0.3",
    "expo-router": "~57.0.7",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "nativewind": "5.0.0-preview.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-native": "0.86.0",
    "react-native-css": "3.0.7",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@babel/core": "7.29.6",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "postcss": "8.5.19",
    "typescript": "~6.0.3"
  }
