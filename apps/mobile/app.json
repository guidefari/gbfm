{
  "expo": {
    "scheme": "gbfm",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ]
    ],
    "name": "mobile",
    "slug": "mobile",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fm.goosebumps.mobile"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
