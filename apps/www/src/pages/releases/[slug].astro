---
import { Effect, Schema } from 'effect'
import MusicLongPost from '@/components/music/MusicLongPost.astro'
import SiteLayout from '@/layouts/SiteLayout.astro'
import { getApiClient } from '@/lib/api-client'
import { nullOnNotFound } from '@/lib/http-errors'
import { generateReleaseSEO, generateSEOHead, notFoundHead } from '@/lib/seo'
import { captureException } from '@/services/analytics'

const slug = Schema.decodeUnknownSync(Schema.NonEmptyString)(Astro.params.slug)
const client = await getApiClient()
const response = await nullOnNotFound(
  Effect.runPromise(
    client.release.getReleaseBySlug({ params: { slug } }).pipe(
      Effect.tapError((error) =>
        Effect.sync(() => captureException(error, { endpoint: 'release.getReleaseBySlug' }))
      )
    )
  )
)
const release = response
  ? {
      ...response,
      bannerImageUrl: null,
      createdAt: new Date(response.createdAt),
      updatedAt: new Date(response.updatedAt),
      releaseDate: response.releaseDate ? new Date(response.releaseDate) : null,
      tags: response.tags ? [...response.tags] : null,
      streamingLinks: response.streamingLinks ? [...response.streamingLinks] : null
    }
  : null
if (!release) Astro.response.status = 404
const head = release
  ? generateSEOHead(generateReleaseSEO(release, slug))
  : notFoundHead('Release', 'Discover music releases on goosebumps.fm')
---

<SiteLayout head={head}>
  {
    release ? (
      <div class='mx-auto max-w-4xl'>
        <MusicLongPost
          title={release.title}
          description={release.description ?? ''}
          content={release.compiledContent ?? release.content}
          thumbnailUrl={release.thumbnailUrl ?? ''}
          date={release.releaseDate ?? release.createdAt}
          slug={slug}
          shareType='release'
        />
      </div>
    ) : (
      <div class='p-4 text-center'>No data</div>
    )
  }
</SiteLayout>
