---
import { Effect, Schema } from 'effect'
import MusicLongPost from '@/components/music/MusicLongPost.astro'
import SiteLayout from '@/layouts/SiteLayout.astro'
import { getApiClient } from '@/lib/api-client'
import { nullOnNotFound } from '@/lib/http-errors'
import { generateSEOHead, generateTrackSEO, notFoundHead } from '@/lib/seo'
import { captureException } from '@/services/analytics'

const trackId = Schema.decodeUnknownSync(Schema.NonEmptyString)(Astro.params.trackId)
const client = await getApiClient()
const response = await nullOnNotFound(
  Effect.runPromise(
    client.audio.getAudioBySlug({ params: { type: 'track', slug: trackId } }).pipe(
      Effect.tapError((error) =>
        Effect.sync(() => captureException(error, { endpoint: 'audio.getAudioBySlug' }))
      )
    )
  )
)
const track = response
  ? {
      ...response,
      bannerImageUrl: null,
      createdAt: new Date(response.createdAt),
      updatedAt: new Date(response.updatedAt),
      tags: response.tags ? [...response.tags] : null,
      creators: response.creators ? [...response.creators] : undefined
    }
  : null
if (!track) Astro.response.status = 404
const head = track
  ? generateSEOHead(generateTrackSEO(track, trackId))
  : notFoundHead('Track', 'Listen to individual tracks on goosebumps.fm')
---

<SiteLayout head={head}>
  {
    track ? (
      <MusicLongPost
        title={track.title}
        description={track.description ?? ''}
        content={track.compiledContent ?? track.content}
        thumbnailUrl={track.thumbnailUrl ?? ''}
        date={track.createdAt}
        mp3Url={track.url}
        slug={trackId}
        shareType='track'
      />
    ) : (
      <div>No data</div>
    )
  }
</SiteLayout>
