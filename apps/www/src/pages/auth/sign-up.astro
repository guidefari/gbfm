---
import { Page, Route } from '@/routes/auth/sign-up'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { buildHref } from '@/lib/navigation'
import { preparePage, isPageRedirect } from '@/lib/prepare-page'

let prepared
try {
  prepared = await preparePage(Route, Astro.url, {}, Astro.locals.auth)
} catch (cause) {
  if (isPageRedirect(cause)) return Astro.redirect(buildHref(cause.options))
  throw cause
}
---

<BaseLayout head={prepared.head}>
  <Page client:load params={prepared.params} search={prepared.search} loaderData={prepared.loaderData} />
</BaseLayout>
