---
import { Effect } from 'effect'
import ShowsBrowser from '@/components/shows/ShowsBrowser.astro'
import SiteLayout from '@/layouts/SiteLayout.astro'
import { getApiClient } from '@/lib/api-client'
import { nullOnNotFound } from '@/lib/http-errors'
import { generateSEOHead, STATIC_PAGE_SEO } from '@/lib/seo'

const client = await getApiClient()
const showsResult = await Effect.runPromise(
  client.shows.getAllShows({ query: { limit: 50, offset: 0 } })
)
const shows = showsResult.data
const requestedSlug = Astro.url.searchParams.get('show')

if (!requestedSlug && shows.length > 0) {
  return Astro.redirect(`/shows?show=${encodeURIComponent(shows[0].slug)}`)
}

const selectedShow = requestedSlug
  ? await nullOnNotFound(
      Effect.runPromise(client.shows.getShowBySlug({ params: { slug: requestedSlug } }))
    )
  : null
const episodes = selectedShow
  ? await Effect.runPromise(
      client.shows.getShowEpisodes({
        params: { slug: selectedShow.slug },
        query: { limit: 50, offset: 0 }
      })
    )
  : null
---

<SiteLayout head={generateSEOHead(STATIC_PAGE_SEO.shows)}>
  <ShowsBrowser
    shows={shows}
    selectedShow={selectedShow}
    episodes={episodes?.data ?? []}
    navigation='query'
  />
</SiteLayout>
