---
import SiteLayout from '@/layouts/SiteLayout.astro'
import { buildHref } from '@/lib/navigation'
import { isPageRedirect, preparePage } from '@/lib/prepare-page'
import { Route } from '@/routes/terms'

let prepared
try {
  prepared = await preparePage(Route, Astro.url, {}, Astro.locals.auth)
} catch (cause) {
  if (isPageRedirect(cause)) return Astro.redirect(buildHref(cause.options))
  throw cause
}
---

<SiteLayout head={prepared.head}>
  <div class='mx-auto max-w-2xl space-y-4 px-6 py-12'>
    <h1 class='text-3xl font-bold'>Terms of Service</h1>
    <p class='text-muted-foreground'>
      Placeholder. Full terms coming soon. Use the service in good faith. No scraping, no abuse, no
      impersonation. We can suspend accounts that violate these basics.
    </p>
  </div>
</SiteLayout>
