---
import { Effect, Schema } from 'effect'
import SiteLayout from '@/layouts/SiteLayout.astro'
import { InteractiveMDX } from '@/components/InteractiveMDX'
import { ShareButton } from '@/components/ShareButton'
import { getApiClient } from '@/lib/api-client'
import { nullOnNotFound } from '@/lib/http-errors'
import { generateLabelSEO, generateSEOHead, notFoundHead } from '@/lib/seo'

const labelSlug = Schema.decodeUnknownSync(Schema.NonEmptyString)(Astro.params.labelSlug)
const client = await getApiClient()
const label = await nullOnNotFound(
  Effect.runPromise(client.music.getLabelBySlug({ params: { slug: labelSlug } }))
)
const links = label
  ? await Effect.runPromise(
      client.music.listEntityLinks({
        params: { entityType: 'label', entityId: label.id },
        query: { status: 'verified' }
      })
    )
  : []

if (!label) Astro.response.status = 404
const head = label
  ? generateSEOHead(
      generateLabelSEO(
        {
          ...label,
          tags: label.tags ? [...label.tags] : null,
          genres: label.genres ? [...label.genres] : null,
          creators: label.creators ? [...label.creators] : undefined,
          affiliatedArtists: label.affiliatedArtists
            ? label.affiliatedArtists.map((artist) => ({
                ...artist,
                genres: artist.genres ? [...artist.genres] : null
              }))
            : undefined,
          affiliatedAlbums: label.affiliatedAlbums
            ? label.affiliatedAlbums.map((album) => ({
                ...album,
                artistNames: album.artistNames ? [...album.artistNames] : null,
                genres: album.genres ? [...album.genres] : null
              }))
            : undefined
        },
        labelSlug
      )
    )
  : notFoundHead('Label', 'Explore music labels on goosebumps.fm')
const isAdmin = Astro.locals.auth.user?.role === 'admin'
---

<SiteLayout head={head}>
  {
    label && (
      <div class='mx-auto max-w-6xl'>
        {label.bannerImageUrl && (
          <img src={label.bannerImageUrl} alt='' class='mb-8 h-48 w-full rounded-sm object-cover sm:h-64' />
        )}
        <div class='grid grid-cols-1 gap-8 lg:grid-cols-3'>
          <aside class='lg:col-span-1'>
            <div class='sticky top-6 space-y-6'>
              <img
                class='w-full rounded-sm'
                src={label.imageUrl || '/fav.png'}
                alt={`Artwork for ${label.name}`}
                width='400'
                height='400'
              />
              <div class='space-y-4'>
                <div class='flex items-start justify-between gap-3'>
                  <h1 class='text-2xl font-bold'>{label.name}</h1>
                  <div class='flex gap-2'>
                    <ShareButton type='label' slug={labelSlug} client:load />
                    {isAdmin && (
                      <a
                        href={`/dashboard/music-entity/label/${encodeURIComponent(label.id)}`}
                        class='inline-flex h-8 items-center rounded-md border border-input bg-background px-3 text-xs font-medium hover:bg-accent hover:text-accent-foreground'
                      >
                        Edit
                      </a>
                    )}
                  </div>
                </div>
                {label.description && <p class='text-muted-foreground'>{label.description}</p>}
                {label.genres && label.genres.length > 0 && (
                  <p class='text-base text-muted-foreground'>{label.genres.join(', ')}</p>
                )}
                {links.length > 0 && (
                  <div>
                    <h2 class='mb-3 text-lg font-semibold'>Links</h2>
                    <div class='flex flex-col gap-2'>
                      {links.map((link) => (
                        <a
                          href={link.url}
                          target='_blank'
                          rel='noopener noreferrer'
                          class='rounded-sm bg-primary/10 px-4 py-2 text-base font-medium capitalize transition-colors hover:bg-primary/20'
                        >
                          {link.platform.replaceAll('_', ' ')}
                        </a>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            </div>
          </aside>
          <main class='space-y-10 lg:col-span-2'>
            <div class='prose prose-neutral max-w-none dark:prose-invert'>
              <InteractiveMDX mdxString={label.compiledContent ?? label.content} client:load />
            </div>
            {(label.affiliatedArtists?.length || label.affiliatedAlbums?.length) && (
              <div class='space-y-10'>
                {label.affiliatedArtists && label.affiliatedArtists.length > 0 && (
                  <section aria-labelledby='label-roster-heading'>
                    <h2 id='label-roster-heading' class='mb-4 text-xl font-semibold'>Roster</h2>
                    <ul class='grid gap-3 sm:grid-cols-2'>
                      {label.affiliatedArtists.map((artist) => (
                        <li class='flex items-center gap-3 rounded-md border p-3'>
                          <img src={artist.imageUrl || '/fav.png'} alt='' class='h-14 w-14 rounded-sm object-cover' />
                          <div class='min-w-0'>
                            <p class='truncate font-medium'>{artist.name}</p>
                            {artist.genres && artist.genres.length > 0 && (
                              <p class='truncate text-base text-muted-foreground'>{artist.genres.join(', ')}</p>
                            )}
                          </div>
                        </li>
                      ))}
                    </ul>
                  </section>
                )}
                {label.affiliatedAlbums && label.affiliatedAlbums.length > 0 && (
                  <section aria-labelledby='label-catalog-heading'>
                    <h2 id='label-catalog-heading' class='mb-4 text-xl font-semibold'>Catalog</h2>
                    <ul class='grid gap-4 sm:grid-cols-2'>
                      {label.affiliatedAlbums.map((album) => (
                        <li class='overflow-hidden rounded-md border'>
                          <img src={album.coverImageUrl || '/fav.png'} alt='' class='aspect-square w-full object-cover' />
                          <div class='space-y-1 p-3'>
                            <p class='font-medium'>{album.title}</p>
                            {album.artistNames && album.artistNames.length > 0 && (
                              <p class='text-base text-muted-foreground'>{album.artistNames.join(', ')}</p>
                            )}
                            {album.releaseDate && (
                              <p class='text-xs text-muted-foreground'>{new Date(album.releaseDate).getFullYear()}</p>
                            )}
                          </div>
                        </li>
                      ))}
                    </ul>
                  </section>
                )}
              </div>
            )}
          </main>
        </div>
      </div>
    )
  }
</SiteLayout>
