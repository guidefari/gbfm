---
import SiteLayout from '@/layouts/SiteLayout.astro'
import { buildHref } from '@/lib/navigation'
import { isPageRedirect, preparePage } from '@/lib/prepare-page'
import { Route } from '@/routes/privacy'

let prepared
try {
  prepared = await preparePage(Route, Astro.url, {}, Astro.locals.auth)
} catch (cause) {
  if (isPageRedirect(cause)) return Astro.redirect(buildHref(cause.options))
  throw cause
}
---

<SiteLayout head={prepared.head}>
  <div class='mx-auto max-w-2xl space-y-4 px-6 py-12'>
    <h1 class='text-3xl font-bold'>Privacy Policy</h1>
    <p class='text-muted-foreground'>
      Placeholder. Full policy coming soon. We store the minimum needed to run the service: account
      info, listening activity you create, and basic analytics. We do not sell your data.
    </p>
  </div>
</SiteLayout>
