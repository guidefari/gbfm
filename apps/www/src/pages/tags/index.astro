---
import { Effect } from 'effect'
import SiteLayout from '@/layouts/SiteLayout.astro'
import { getApiClient } from '@/lib/api-client'
import { generateSEOHead, STATIC_PAGE_SEO } from '@/lib/seo'

const client = await getApiClient()
const tags = await Effect.runPromise(client.post.getPostTags({}))
---

<SiteLayout head={generateSEOHead(STATIC_PAGE_SEO.tags)}>
  <div class='mx-auto max-w-2xl px-4 py-8'>
    <h1 class='mb-6 text-lg font-black tracking-tight text-foreground'>Tags</h1>
    {
      tags.length === 0 ? (
        <p class='text-base text-muted-foreground'>No tags yet.</p>
      ) : (
        <div class='flex flex-wrap gap-x-4 gap-y-2'>
          {tags.map((tag) => (
            <a
              href={`/tags/${encodeURIComponent(tag)}`}
              class='text-base text-muted-foreground no-underline transition-colors hover:text-foreground'
            >
              #{tag}
            </a>
          ))}
        </div>
      )
    }
  </div>
</SiteLayout>
