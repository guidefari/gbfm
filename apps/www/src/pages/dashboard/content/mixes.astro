---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { canCreatePosts } from '@gbfm/core/roles'
import { buildHref } from '@/lib/navigation'
import { PageRedirect } from '@/lib/page'
import { preparePage } from '@/lib/prepare-page'
import { Page, Route } from '@/routes/dashboard/content.mixes'

if (!Astro.locals.auth.isAuthenticated)
  return Astro.redirect(buildHref({ to: '/auth/sign-in', search: { redirect: Astro.url.href } }))
if (!canCreatePosts(Astro.locals.auth.user?.role)) return Astro.redirect('/dashboard')
let prepared
try {
  prepared = await preparePage(Route, Astro.url, {}, Astro.locals.auth)
} catch (cause) {
  if (cause instanceof PageRedirect) return Astro.redirect(buildHref(cause.options))
  throw cause
}
---
<BaseLayout head={prepared.head}>
  <Page client:load params={prepared.params} search={prepared.search} loaderData={prepared.loaderData} />
</BaseLayout>
