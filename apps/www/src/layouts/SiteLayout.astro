---
import { ClientChrome } from '@/components/ClientChrome'
import { MAIN_SCROLL_CONTAINER_ID } from '@/lib/constants'
import type { PageHead } from '@/lib/page'
import BaseLayout from './BaseLayout.astro'

interface Props {
  readonly head?: PageHead
}

const { head } = Astro.props
---

<BaseLayout head={head}>
  <div class='grid h-dvh w-full grid-cols-1 bg-background'>
    <div class='relative flex h-dvh min-w-0 flex-col overflow-hidden'>
      <div class='relative min-h-0 flex-1'>
        <main
          id={MAIN_SCROLL_CONTAINER_ID}
          tabindex='-1'
          style='overflow-anchor: none'
          class='h-full min-w-0 overflow-x-hidden overflow-y-auto bg-background pb-[calc(2.75rem+env(safe-area-inset-bottom))] focus:outline-none lg:pb-12 [&::-webkit-scrollbar]:hidden [scrollbar-width:none]'
        >
          <slot />
        </main>
      </div>
      <ClientChrome client:load transition:persist />
    </div>
  </div>
</BaseLayout>
