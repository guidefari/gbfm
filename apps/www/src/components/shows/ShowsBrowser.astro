---
import { ShowActions } from '@/components/shows/ShowActions'
import { ShowEpisodes } from '@/components/shows/ShowEpisodes'

type Show = {
  readonly id: string
  readonly slug: string
  readonly title: string
  readonly description: string | null
  readonly thumbnailUrl: string | null
  readonly bannerImageUrl: string | null
  readonly content: string
  readonly draft: boolean
  readonly tags: readonly string[] | null
  readonly hosts?: ReadonlyArray<{ readonly id: string; readonly name: string }>
}

type Episode = {
  readonly id: string
  readonly slug: string
  readonly title: string
  readonly createdAt: string
  readonly updatedAt: string
  readonly tags: readonly string[] | null
  readonly url: string
  readonly type: 'mix' | 'track' | 'misc'
  readonly thumbnailUrl: string | null
  readonly draft: boolean
  readonly creators?: ReadonlyArray<{
    readonly id: string
    readonly name: string
    readonly username: string | null
  }>
}

interface Props {
  readonly shows: ReadonlyArray<Show>
  readonly selectedShow: Show | null
  readonly episodes: ReadonlyArray<Episode>
  readonly navigation: 'query' | 'path'
}

const { shows, selectedShow, episodes, navigation } = Astro.props
const showHref = (slug: string) =>
  navigation === 'query' ? `/shows?show=${encodeURIComponent(slug)}` : `/shows/${encodeURIComponent(slug)}`
const hostNames = selectedShow?.hosts?.map((host) => host.name).join(', ')
---

<div class='w-full px-4 py-4 sm:px-6 sm:py-6'>
  <div class='grid grid-cols-1 gap-6 lg:grid-cols-[220px_minmax(0,1fr)_240px] lg:gap-10'>
    <aside class='hidden lg:block'>
      <div class='no-scrollbar sticky top-4 max-h-[calc(100dvh-8rem)] overflow-y-auto'>
        {
          selectedShow && (
            <>
              <h2 class='mb-2 border-b border-border/60 pb-2 text-xs font-semibold tracking-wider text-muted-foreground'>
                Show
              </h2>
              <div class='min-w-0 font-mono'>
                <img
                  src={selectedShow.thumbnailUrl || '/fav.png'}
                  alt={selectedShow.title}
                  width='400'
                  height='400'
                  class='aspect-square w-full rounded-[2px] object-cover'
                />
                <h2 class='mt-3 text-lg font-bold tracking-tight text-foreground'>{selectedShow.title}</h2>
                {hostNames && <p class='mt-1 text-xs text-muted-foreground'>hosted by {hostNames}</p>}
                {selectedShow.description && (
                  <p class='mt-3 border-t border-border/40 pt-3 text-xs leading-relaxed text-muted-foreground'>
                    {selectedShow.description}
                  </p>
                )}
                <ShowActions show={selectedShow} client:load />
              </div>
            </>
          )
        }
      </div>
    </aside>

    <div class='space-y-4 lg:hidden'>
      <nav class='no-scrollbar flex gap-2 overflow-x-auto' aria-label='Show switcher'>
        {
          shows.map((show) => (
            <a
              href={showHref(show.slug)}
              aria-current={selectedShow?.id === show.id ? 'page' : undefined}
              class:list={[
                'shrink-0 whitespace-nowrap rounded-sm border px-2.5 py-1 text-xs font-semibold transition-colors',
                selectedShow?.id === show.id
                  ? 'border-highlight bg-secondary text-highlight'
                  : 'border-border text-foreground/70 hover:bg-muted/40'
              ]}
            >
              {show.title}
            </a>
          ))
        }
      </nav>
      {
        selectedShow && (
          <div class='min-w-0 font-mono'>
            <img
              src={selectedShow.thumbnailUrl || '/fav.png'}
              alt={selectedShow.title}
              width='400'
              height='400'
              class='aspect-square w-full rounded-[2px] object-cover'
            />
            <h2 class='mt-3 text-lg font-bold tracking-tight text-foreground'>{selectedShow.title}</h2>
            {hostNames && <p class='mt-1 text-xs text-muted-foreground'>hosted by {hostNames}</p>}
            {selectedShow.description && (
              <p class='mt-3 border-t border-border/40 pt-3 text-xs leading-relaxed text-muted-foreground'>
                {selectedShow.description}
              </p>
            )}
            <ShowActions show={selectedShow} client:load />
          </div>
        )
      }
    </div>

    <main class='min-w-0'>
      {selectedShow && <h1 class='mb-3 border-b border-border/60 pb-2 text-xs font-semibold tracking-wider text-muted-foreground'>Episodes</h1>}
      {
        !selectedShow ? (
          <div class='py-12 text-center text-muted-foreground'>Select a show to browse its mixes</div>
        ) : episodes.length === 0 ? (
          <div class='py-8 text-center font-jetbrains text-base text-muted-foreground'>No episodes yet</div>
        ) : (
          <ShowEpisodes episodes={episodes} client:load />
        )
      }
    </main>

    <aside class='hidden lg:block'>
      <div class='no-scrollbar sticky top-4 max-h-[calc(100dvh-8rem)] overflow-y-auto pl-1'>
        <h2 class='mb-2 border-b border-border/60 pb-2 text-xs font-semibold tracking-wider text-muted-foreground'>All shows</h2>
        <nav aria-label='Shows' class='font-jetbrains text-base'>
          {
            shows.map((show) => {
              const names = show.hosts?.map((host) => host.name).join(', ')
              return (
                <a
                  href={showHref(show.slug)}
                  aria-current={selectedShow?.id === show.id ? 'page' : undefined}
                  class:list={[
                    'flex w-full items-center gap-2 border-b border-border/40 px-1 py-1.5 text-left transition-colors last:border-b-0',
                    selectedShow?.id === show.id ? 'text-highlight' : 'text-foreground/70 hover:text-foreground'
                  ]}
                >
                  <img
                    src={show.thumbnailUrl || '/fav.png'}
                    alt={show.title}
                    width='32'
                    height='32'
                    class='size-8 shrink-0 rounded-[2px] object-cover'
                  />
                  <span class='min-w-0 flex-1'>
                    <span class='block truncate'>{show.title}</span>
                    {names && <span class='block truncate text-xs text-muted-foreground'>{names}</span>}
                  </span>
                </a>
              )
            })
          }
        </nav>
      </div>
    </aside>
  </div>
</div>
