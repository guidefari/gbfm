{
  "name": "@gbfm/vps",
  "exports": {
    "./schemas": "./src/db/exports.ts"
  },
  "scripts": {
    "dev": "bun --hot --preload ./src/instrument.ts src/index.ts",
    "dev:proddb": "DB_STAGE=prod bun --hot --preload ./src/instrument.ts src/index.ts",
    "start": "bun --preload ./src/instrument.ts src/index.ts",
    "test": "TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE=/var/run/docker.sock DOCKER_HOST=unix:///var/run/docker.sock vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:watch": "TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE=/var/run/docker.sock DOCKER_HOST=unix:///var/run/docker.sock vitest",
    "typecheck": "tsgo --noEmit",
    "db:studio": "drizzle-kit studio",
    "db:yeet": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate && bun run scripts/seed-music-lookups.ts",
    "db:gen": "drizzle-kit generate",
    "db:migrate:prod": "bun sst shell --stage=prod bun run src/migrate.ts",
    "db:seed:music-lookups": "bun run scripts/seed-music-lookups.ts",
    "db:deets:prod": "bun sst shell --stage=prod bun run ./scripts/db.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1038.0",
    "@aws-sdk/s3-request-presigner": "3.1038.0",
    "@effect/cli": "0.75.2",
    "@effect/experimental": "0.60.0",
    "@effect/opentelemetry": "4.0.0-beta.93",
    "@effect/platform": "0.96.2",
    "@effect/platform-bun": "4.0.0-beta.93",
    "@gbfm/api": "workspace:*",
    "@gbfm/core": "workspace:*",
    "@gbfm/email": "workspace:*",
    "@mdx-js/mdx": "3.1.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.215.0",
    "@opentelemetry/resources": "2.7.0",
    "@opentelemetry/sdk-metrics": "2.7.0",
    "@opentelemetry/sdk-trace-base": "2.7.0",
    "@opentelemetry/sdk-trace-node": "2.7.0",
    "@opentelemetry/sdk-trace-web": "2.7.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@sentry/bun": "^10.52.0",
    "@sentry/opentelemetry": "^10.52.0",
    "@spotify/web-api-ts-sdk": "1.2.0",
    "@types/qrcode": "1.5.6",
    "better-auth": "1.6.18",
    "dotenv": "17.4.2",
    "dotenv-expand": "13.0.0",
    "drizzle-orm": "0.45.2",
    "effect": "4.0.0-beta.99",
    "gray-matter": "4.0.3",
    "openapi-fetch": "^0.17.0",
    "pdf-lib": "1.17.1",
    "pg": "8.20.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "qrcode": "1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "resend": "6.12.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@effect/language-service": "0.86.4",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/aws-lambda": "8.10.161",
    "@types/bun": "1.3.13",
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.10",
    "openapi-typescript": "^7.13.0",
    "typescript": "6.0.3"
  }
}
