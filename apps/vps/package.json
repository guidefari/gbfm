{
  "name": "@gbfm/vps",
  "exports": {
    "./schemas": "./src/db/exports.ts"
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "dev:proddb": "DB_STAGE=prod bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:studio": "drizzle-kit studio",
    "db:yeet": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:gen": "drizzle-kit generate",
    "db:migrate:prod": "bun sst shell --stage=prod bun run src/migrate.ts",
    "db:deets:prod": "bun sst shell --stage=prod bun run ./scripts/db.ts",
    "db:backup": "bun run scripts/backup-db.ts",
    "db:backup:prod": "bun sst shell --stage=prod bun run scripts/backup-db.ts",
    "db:backup:local": "bun run scripts/backup-db-local.ts",
    "db:backup:docker": "./scripts/docker-backup.sh",
    "db:restore": "bun run scripts/restore-db.ts",
    "db:restore:docker": "./scripts/docker-restore.sh"
  },
  "devDependencies": {
    "@effect/language-service": "^0.72.0",
    "@types/aws-lambda": "8.10.159",
    "@types/bun": "1.3.6",
    "@types/pg": "^8.16.0",
    "drizzle-kit": "^0.31.8",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.971.0",
    "@aws-sdk/lib-storage": "^3.971.0",
    "@aws-sdk/s3-request-presigner": "^3.971.0",
    "@effect/cli": "0.73.0",
    "@effect/experimental": "0.58.0",
    "@effect/opentelemetry": "^0.60.0",
    "@effect/platform": "0.94.1",
    "@effect/platform-bun": "0.87.0",
    "@gbfm/email": "workspace:*",
    "@hono/zod-openapi": "1.2.0",
    "@hono/zod-validator": "0.7.6",
    "@mdx-js/mdx": "3.1.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.210.0",
    "@opentelemetry/resources": "^2.5.0",
    "@opentelemetry/sdk-metrics": "^2.4.0",
    "@opentelemetry/sdk-trace-base": "2.4.0",
    "@opentelemetry/sdk-trace-node": "2.4.0",
    "@scalar/hono-api-reference": "0.9.34",
    "@spotify/web-api-ts-sdk": "1.2.0",
    "better-auth": "^1.4.15",
    "dotenv": "^17.2.3",
    "dotenv-expand": "^12.0.3",
    "drizzle-orm": "0.45.1",
    "effect": "3.19.15",
    "ffmpeg-static": "^5.3.0",
    "gray-matter": "4.0.3",
    "hono": "4.11.4",
    "hono-pino": "0.10.3",
    "pg": "^8.17.1",
    "pino": "10.2.0",
    "pino-pretty": "13.1.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "resend": "6.7.0",
    "stoker": "2.0.1"
  }
}
