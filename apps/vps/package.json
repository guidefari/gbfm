{
  "name": "@gbfm/vps",
  "exports": {
    "./schemas": "./src/db/exports.ts"
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:studio": "drizzle-kit studio",
    "db:yeet": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:gen": "drizzle-kit generate",
    "db:migrate:prod": "bun sst shell --stage=prod bun run src/migrate.ts",
    "db:deets:prod": "bun sst shell --stage=prod bun run ./scripts/db.ts"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.145",
    "@types/bun": "^1.2.23",
    "@types/pg": "^8.15.4",
    "drizzle-kit": "^0.30.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.901.0",
    "@aws-sdk/lib-storage": "^3.903.0",
    "@aws-sdk/s3-request-presigner": "^3.901.0",
    "@gbfm/email": "workspace:*",
    "@hono/zod-openapi": "^1.1.3",
    "@hono/zod-validator": "^0.7.3",
    "@mdx-js/mdx": "3.1.1",
    "@scalar/hono-api-reference": "^0.9.20",
    "@spotify/web-api-ts-sdk": "^1.2.0",
    "dotenv": "^17.2.3",
    "dotenv-expand": "^12.0.3",
    "drizzle-orm": "0.44.6",
    "ffmpeg-static": "^5.2.0",
    "gray-matter": "4.0.3",
    "hono": "4.9.10",
    "hono-pino": "^0.10.3",
    "pg": "^8.16.3",
    "pino": "^9.13.1",
    "pino-pretty": "^13.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "resend": "^6.1.2",
    "stoker": "^2.0.1"
  }
}
