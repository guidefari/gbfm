{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "plugins": [{ "name": "@effect/language-service" }],
    "types": ["@types/bun"],
    "paths": {
      "*": ["./*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "drizzle/**/*", "sst-env.d.ts", "scripts/**/*"],
  "exclude": [
    "src/archive",
    "node_modules",
    "../../packages/email/emails/**/*",
    "scripts/assign-all-relations-to-user.ts",
    "scripts/backfill-draft-music-entities.ts",
    "scripts/backfill-episode-numbers.ts",
    "scripts/fix-mix-created-dates.ts",
    "scripts/migrate-mixes-to-main-show.ts",
    "scripts/migrate-users-to-better-auth.ts",
    "scripts/rename-audio-cdn-name.ts",
    "scripts/seed-music-lookups.ts"
  ]
}
