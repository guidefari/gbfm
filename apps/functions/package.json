    "@aws-sdk/client-s3": "^3.901.0",
    "@aws-sdk/s3-request-presigner": "^3.901.0",
    "@aws-sdk/lib-dynamodb": "^3.902.0",
    "@gbfm/core": "workspace:",
    "@hono/swagger-ui": "^0.5.2",
    "@hono/valibot-validator": "^0.5.3",
    "@hono/zod-openapi": "^1.1.3",
    "@spotify/web-api-ts-sdk": "^1.2.0",
    "cloudflare": "^5.2.0",
    "hono": "^4.9.10"
