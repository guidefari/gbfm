{
  "name": "@gbfm/theme",
  "version": "0.0.1",
  "type": "module",
  "sideEffects": [
    "./styles/theme.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens/brand.ts",
    "./styles.css": "./styles/theme.css"
  },
  "scripts": {
    "build:css": "bun src/build-css.ts && oxfmt styles/theme.css --write",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  }
}
