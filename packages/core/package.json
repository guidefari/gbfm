{
  "name": "@gbfm/core",
  "type": "module",
  "exports": {
    "./*.sql": "./src/*.sql.ts",
    "./*.ts": "./src/*.ts",
    "./*.tsx": "./src/*.tsx",
    "./*": "./src/*.ts",
    "./seed-mixes": "./src/archive/seed-mixes.ts"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "email dev --dir src/email",
    "db:gen": "sst shell drizzle-kit generate",
    "db:migrate": "sst shell drizzle-kit migrate",
    "db:studio": "sst shell drizzle-kit studio",
    "db": "sst shell drizzle-kit",
    "db:seed": "sst shell bun src/drizzle/seed.ts",
    "db:seed:mixes": "bun src/archive/seed-mixes.ts",
    "archive:seed": "bun src/archive/seed.ts"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "react-email": "4.0.16"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.901.0",
    "@aws-sdk/client-ses": "^3.901.0",
    "@aws-sdk/client-sesv2": "^3.901.0",
    "@aws-sdk/s3-request-presigner": "^3.901.0",
    "@gbfm/email": "workspace:*",
    "@hono/valibot-validator": "^0.5.3",
    "@hono/zod-openapi": "^1.1.3",
    "@react-email/components": "0.5.5",
    "@types/bun": "^1.2.23",
    "dotenv": "^17.2.3",
    "dotenv-expand": "^12.0.3",
    "drizzle-kit": "0.31.5",
    "drizzle-orm": "0.44.6",
    "hono": "^4.9.10",
    "pg": "^8.13.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  }
}
