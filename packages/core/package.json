{
  "name": "@gbfm/core",
  "type": "module",
  "exports": {
    "./*.sql": "./src/*.sql.ts",
    "./*.ts": "./src/*.ts",
    "./*.tsx": "./src/*.tsx",
    "./*": "./src/*.ts",
    "./seed-mixes": "./src/archive/seed-mixes.ts"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "email dev --dir src/email",
    "db:gen": "sst shell drizzle-kit generate",
    "db:migrate": "sst shell drizzle-kit migrate",
    "db:studio": "sst shell drizzle-kit studio",
    "db": "sst shell drizzle-kit",
    "db:seed": "sst shell bun src/drizzle/seed.ts",
    "db:seed:mixes": "bun src/archive/seed-mixes.ts",
    "archive:seed": "bun src/archive/seed.ts"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "react-email": "4.0.16"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.645.0",
    "@aws-sdk/client-ses": "^3.828.0",
    "@aws-sdk/s3-request-presigner": "^3.645.0",
    "@hono/valibot-validator": "^0.3.0",
    "@hono/zod-openapi": "^0.16.0",
    "@react-email/components": "0.0.42",
    "@types/bun": "^1.1.14",
    "dotenv": "^16.4.5",
    "dotenv-expand": "^11.0.6",
    "drizzle-kit": "0.27.1",
    "drizzle-orm": "0.41.0",
    "hono": "^4.5.10",
    "pg": "^8.13.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  }
}
